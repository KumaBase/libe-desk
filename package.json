{
  "name": "libe-desk",
  "version": "0.2.2",
  "description": "Libe Desk - リベシティ非公式デスクトップアプリ",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KumaBase/libe-desk.git"
  },
  "homepage": "https://github.com/KumaBase/libe-desk#readme",
  "bugs": {
    "url": "https://github.com/KumaBase/libe-desk/issues"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "serve": "vite preview",
    "tauri": "tauri",
    "version:check": "node scripts/check-version.mjs",
    "dist:local": "bash scripts/sync-dist-local.sh",
    "build:mac:signed": "tauri build --config src-tauri/tauri.signed.conf.json --bundles app",
    "test": "node --test tests/*.test.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "jsdom": "^26.1.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vite-plugin-solid": "^2.11.0"
  }
}
